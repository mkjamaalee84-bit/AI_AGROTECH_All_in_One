rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() {
   return request.auth != null
    && request.auth.token.firebase.sign_in_provider == 'password';
  }
  function memberPath(companyId) {
   return /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid);
  }
  function staff(companyId) {
   return companyId == 'yp-agrotech-bioflok'
    && signedIn()
    && exists(memberPath(companyId))
    && get(memberPath(companyId)).data.active == true
    && get(memberPath(companyId)).data.role in ['staff', 'admin'];
  }
  function admin(companyId) {
   return staff(companyId) && get(memberPath(companyId)).data.role == 'admin';
  }
  function validReport(d, reportId) {
   return d.keys().hasAll(['id','at','pond','ph','do','tan','temp','notes','updated','deleted','createdBy','createdByName','source','createdAt','updatedAt'])
    && d.keys().hasOnly(['id','at','pond','ph','do','tan','temp','notes','updated','deleted','createdBy','createdByName','source','createdAt','updatedAt'])
    && reportId.matches('^[A-Za-z0-9_-]{10,100}$') && d.id == reportId
    && d.at is string && d.at.size() <= 50
    && d.updated is string && d.updated.size() <= 50
    && d.pond is string && d.pond.size() > 0 && d.pond.size() <= 80
    && d.notes is string && d.notes.size() <= 2000
    && d.ph is number && d.ph >= 0 && d.ph <= 14
    && d['do'] is number && d['do'] >= 0 && d['do'] <= 30
    && d.tan is number && d.tan >= 0 && d.tan <= 1000
    && d.temp is number && d.temp >= 0 && d.temp <= 60
    && d.deleted is bool
    && d.createdBy is string && d.createdByName is string && d.createdByName.size() <= 120
    && d.source in ['live','legacy']
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /companies/{companyId}/members/{userId} {
   // A user may inspect only their own membership. Enrollment is admin-console-only.
   allow get: if companyId == 'yp-agrotech-bioflok' && signedIn() && request.auth.uid == userId;
   allow list, create, update, delete: if false;
  }
  match /companies/{companyId}/reports/{reportId} {
   allow read: if staff(companyId);
   allow create: if staff(companyId)
    && validReport(request.resource.data, reportId)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.deleted == false
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && (request.resource.data.source == 'live' || admin(companyId));
   // The author or an admin may soft-delete; the original measurement is immutable.
   allow update: if staff(companyId)
    && validReport(request.resource.data, reportId)
    && (resource.data.createdBy == request.auth.uid || admin(companyId))
    && resource.data.deleted == false && request.resource.data.deleted == true
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','updated','updatedAt'])
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // Every other collection is denied unless you explicitly add reviewed rules.
  match /{path=**} { allow read, write: if false; }
 }
}
